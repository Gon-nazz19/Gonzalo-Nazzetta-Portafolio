# Copiar como .env para probar el formulario en local (npm run dev).
# En producción se leen de GitHub → Settings → Secrets and variables → Actions → Variables.

# URL a la que el formulario hace POST en JSON. Vacía = botón que abre un mailto.
#   Formspree:  https://formspree.io/f/XXXXXXXX
#   Web3Forms:  https://api.web3forms.com/submit
#   Propio:     https://contacto.tu-cuenta.workers.dev  ó  https://<proyecto>.supabase.co/functions/v1/contacto
PUBLIC_CONTACT_ENDPOINT=

# Solo para Web3Forms (access key pública).
PUBLIC_CONTACT_ACCESS_KEY=
