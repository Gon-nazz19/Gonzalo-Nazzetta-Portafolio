---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SobreMi from '../components/SobreMi.astro';
import PipelineConnector from '../components/PipelineConnector.astro';
import Experiencia from '../components/Experiencia.astro';
import Proyectos from '../components/Proyectos.astro';
import Habilidades from '../components/Habilidades.astro';
import Formacion from '../components/Formacion.astro';
import Publicaciones from '../components/Publicaciones.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Navbar />
  <main id="contenido" class="flex-1">
    <Hero />
    <SobreMi />
    <PipelineConnector />
    <Experiencia />
    <Proyectos />
    <Habilidades />
    <Formacion />
    <Publicaciones />
    <Contacto />
  </main>
  <Footer />
</Base>
