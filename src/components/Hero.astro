---
import { ArrowDown, Compass, Download, MapPin } from '@lucide/astro';
import { Image } from 'astro:assets';
import HeroChart from './HeroChart.astro';
import foto from '../assets/gonzalo-nazzetta.webp';
import { datos } from '../data/perfil';
import { withBase } from '../lib/url';
---

<section id="inicio" aria-labelledby="hero-titulo" class="relative border-b border-outline/70 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none hidden lg:flex items-center justify-end opacity-35">
    <HeroChart />
  </div>

  <div class="max-w-[1200px] mx-auto px-md lg:px-lg py-2xl lg:py-3xl relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-xl lg:gap-2xl items-center">
    <!-- Foto: anillo fino en gradiente primario y glow suave -->
    <div class="lg:col-span-4 flex justify-center lg:justify-start">
      <div class="relative">
        <div class="absolute -inset-6 rounded-full bg-primary/25 blur-3xl" aria-hidden="true"></div>
        <div class="relative rounded-full p-[3px] bg-linear-to-br from-primary to-accent shadow-[0_0_48px_-6px_rgb(79_195_247/0.5)]">
          <Image
            src={foto}
            alt="Gonzalo Nazzetta"
            width={300}
            height={300}
            densities={[1, 2]}
            loading="eager"
            fetchpriority="high"
            class="block w-44 h-44 sm:w-56 sm:h-56 lg:w-[300px] lg:h-[300px] rounded-full object-cover border-[6px] border-background"
          />
        </div>
      </div>
    </div>

    <div class="lg:col-span-8 flex flex-col gap-lg">
      <p class="inline-flex items-center gap-sm self-start px-md py-xs rounded-full bg-surface border border-accent/25">
        <MapPin class="w-4 h-4 text-accent" aria-hidden="true" />
        <span class="font-mono text-mono-sm text-accent">{datos.ubicacion}</span>
      </p>

      <div class="flex flex-col gap-sm">
        <h1 id="hero-titulo" class="font-display text-display-lg-mobile lg:text-display-lg text-on-surface text-balance">
          {datos.nombre}
        </h1>
        <p class="font-headline text-title-lg lg:text-headline-md text-accent text-balance">{datos.titulo}</p>
        <p class="font-body text-body-md lg:text-body-lg text-on-surface-muted max-w-[42rem] text-pretty">{datos.bajada}</p>
      </div>

      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-md pt-sm">
        <a
          href="#proyectos"
          class="inline-flex items-center justify-center gap-sm px-lg py-md rounded bg-linear-to-r from-primary to-accent text-on-primary font-label text-label-lg shadow-lg hover:opacity-95 transition-opacity duration-200 whitespace-nowrap"
        >
          Ver proyectos
          <ArrowDown class="w-4 h-4" aria-hidden="true" />
        </a>
        <a
          href={withBase(datos.cv)}
          download
          class="inline-flex items-center justify-center gap-sm px-lg py-md rounded bg-surface border border-accent/30 text-on-surface font-label text-label-lg hover:border-accent hover:bg-surface-elevated transition-colors duration-200 whitespace-nowrap"
        >
          <Download class="w-4 h-4 text-accent" aria-hidden="true" />
          Descargar CV
          <span class="sr-only">(PDF)</span>
        </a>
      </div>
    </div>
  </div>

  <div class="pb-lg flex justify-center relative z-10">
    <a href="#sobre-mi" class="inline-flex items-center gap-xs text-on-surface-muted hover:text-accent font-mono text-mono-sm transition-colors duration-200 rounded">
      <Compass class="w-4 h-4 text-accent" aria-hidden="true" />
      Explorar recorrido
    </a>
  </div>
</section>
