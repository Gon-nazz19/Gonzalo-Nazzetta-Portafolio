---
import { BookOpen, GraduationCap } from '@lucide/astro';
import SectionHeader from './SectionHeader.astro';
import { publicacion } from '../data/perfil';
---

<section id="publicaciones" aria-labelledby="publicaciones-titulo" class="py-2xl lg:py-section border-b border-outline/60">
  <div class="max-w-[1200px] mx-auto px-md lg:px-lg flex flex-col gap-xl">
    <SectionHeader id="publicaciones-titulo" codigo="citation.bib" titulo="Publicaciones" />

    <article class="reveal fx-card bg-surface border border-accent/30 rounded-lg p-lg lg:p-xl grid grid-cols-1 lg:grid-cols-12 gap-xl items-center">
      <div class="lg:col-span-8 flex flex-col gap-md">
        <p class="inline-flex items-center gap-sm self-start px-md py-xs rounded-full bg-primary/20 border border-accent/30 font-mono text-mono-sm text-accent">
          <GraduationCap class="w-4 h-4" aria-hidden="true" />
          {publicacion.etiqueta}
        </p>
        <h3 class="font-headline text-headline-md text-on-surface text-balance">“{publicacion.titulo}”</h3>
        <p class="font-body text-body-md text-on-surface">{publicacion.evento}</p>
        <p class="font-body text-body-md text-on-surface-muted">{publicacion.descripcion}</p>
        <p class="font-mono text-mono-sm text-accent">Holt-Winters · SARIMA · Series de tiempo</p>
        {
          publicacion.url && (
            <a
              href={publicacion.url}
              target="_blank"
              rel="noopener noreferrer"
              class="self-start inline-flex items-center gap-sm px-lg py-sm rounded bg-linear-to-r from-primary to-accent text-on-primary font-label text-label-lg hover:opacity-95"
            >
              <BookOpen class="w-4 h-4" aria-hidden="true" />
              Leer el paper
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          )
        }
      </div>

      <div class="lg:col-span-4 bg-background border border-outline rounded-md p-md flex flex-col gap-sm" aria-hidden="true">
        <span class="font-mono text-label-sm text-on-surface-muted">Vista previa del modelo</span>
        <svg viewBox="0 0 260 120" class="w-full h-28" fill="none">
          <path d="M12 96 C 45 86, 70 52, 105 58 C 122 61, 134 45, 145 42" stroke="#1E6FFF" stroke-width="2.5" stroke-linecap="round"></path>
          <path d="M145 42 C 175 28, 210 24, 248 38" stroke="#4FC3F7" stroke-width="2.5" stroke-dasharray="5 5" stroke-linecap="round"></path>
          <path d="M145 30 C 175 16, 210 12, 248 24 L 248 52 C 210 40, 175 44, 145 54 Z" fill="#4FC3F7" fill-opacity="0.16"></path>
          <circle cx="145" cy="42" r="4" fill="#4FC3F7"></circle>
        </svg>
      </div>
    </article>
  </div>
</section>
