---
import { ChartLine, Compass, FileText, FlaskConical } from '@lucide/astro';
import SectionHeader from './SectionHeader.astro';
import { kpis, sobreMi, type Kpi } from '../data/perfil';

const iconos: Record<Kpi['icono'], typeof FileText> = {
  paper: FileText,
  investigacion: FlaskConical,
  analisis: ChartLine,
  scout: Compass,
};
---

<section id="sobre-mi" aria-labelledby="sobre-mi-titulo" class="py-2xl lg:py-section border-b border-outline/60">
  <div class="max-w-[1200px] mx-auto px-md lg:px-lg flex flex-col gap-xl">
    <SectionHeader id="sobre-mi-titulo" codigo="> sobre_mi.py" titulo="Sobre mí" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg items-stretch">
      <article class="reveal lg:col-span-7 bg-surface border border-accent/20 rounded-lg p-lg flex flex-col gap-md">
        {
          sobreMi.map((p, i) => (
            <p class:list={['font-body text-pretty', i === 0 ? 'text-body-lg text-on-surface' : 'text-body-md text-on-surface-muted']}>
              {p}
            </p>
          ))
        }
      </article>

      <ul class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-lg" aria-label="Indicadores">
        {
          kpis.map((k, i) => {
            const Icono = iconos[k.icono];
            return (
              <li class="reveal bg-surface border border-accent/20 rounded-lg p-lg flex flex-col justify-between gap-md hover:border-accent/50 transition-colors duration-200">
                <div class="flex items-start justify-between gap-sm">
                  <div>
                    <h3 class="font-headline text-title-lg text-on-surface">{k.titulo}</h3>
                    <p class="font-mono text-mono-sm text-accent">{k.detalle}</p>
                  </div>
                  <Icono class="w-6 h-6 shrink-0 text-accent" aria-hidden="true" />
                </div>
                <div class="flex justify-end" aria-hidden="true">
                  {i === 0 && (
                    <svg viewBox="0 0 80 28" class="w-20 h-7" fill="none">
                      <path d="M2 24 L18 19 L34 21 L50 10 L66 13 L78 4" stroke="#4FC3F7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 64 28" class="w-16 h-7" fill="none">
                      <rect x="4" y="16" width="8" height="10" rx="2" fill="#1E6FFF" />
                      <rect x="18" y="10" width="8" height="16" rx="2" fill="#1E6FFF" />
                      <rect x="32" y="13" width="8" height="13" rx="2" fill="#00B4D8" />
                      <rect x="46" y="4" width="8" height="22" rx="2" fill="#4FC3F7" />
                    </svg>
                  )}
                  {i === 2 && (
                    <svg viewBox="0 0 80 28" class="w-20 h-7" fill="none">
                      <path d="M2 20 C 16 8, 28 24, 42 12 C 56 4, 66 16, 78 8" stroke="#00B4D8" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  )}
                  {i === 3 && (
                    <svg viewBox="0 0 80 28" class="w-20 h-7" fill="none">
                      <path d="M4 22 C 20 6, 36 26, 52 12 S 72 8, 76 6" stroke="#4FC3F7" stroke-opacity="0.6" stroke-width="1.5" stroke-dasharray="3 4" stroke-linecap="round" />
                      <circle cx="76" cy="6" r="3" fill="#4FC3F7" />
                    </svg>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
