---
// Logo oficial de simple-icons como SVG inline (usa currentColor).
import type { SimpleIcon } from 'simple-icons';

interface Props {
  icon: SimpleIcon;
  class?: string;
  title?: string;
}
const { icon, class: className, title } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path d={icon.path}></path>
</svg>
