---
import { GraduationCap, Languages } from '@lucide/astro';
import SectionHeader from './SectionHeader.astro';
import { formacion, idiomas } from '../data/perfil';
---

<section id="formacion" aria-labelledby="formacion-titulo" class="py-2xl lg:py-section border-b border-outline/60">
  <div class="max-w-[1200px] mx-auto px-md lg:px-lg flex flex-col gap-xl">
    <SectionHeader id="formacion-titulo" codigo="ls ./formacion" titulo="Formación" />

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-lg">
      {
        formacion.map((f) => (
          <li class="reveal fx-card fx-tilt bg-surface border border-accent/20 rounded-lg p-lg flex flex-col gap-sm hover:border-accent/50 transition-colors duration-200">
            <GraduationCap class="w-6 h-6 text-accent" aria-hidden="true" />
            <h3 class="font-headline text-title-md text-on-surface text-balance">{f.titulo}</h3>
            <p class="font-body text-body-sm text-on-surface-muted">{f.institucion}</p>
            <p class="mt-auto pt-sm font-mono text-mono-sm text-accent">{f.periodo}</p>
          </li>
        ))
      }
      <li class="reveal fx-card fx-tilt bg-surface border border-accent/20 rounded-lg p-lg flex flex-col gap-sm hover:border-accent/50 transition-colors duration-200">
        <Languages class="w-6 h-6 text-accent" aria-hidden="true" />
        <h3 class="font-headline text-title-md text-on-surface">Idiomas</h3>
        <p class="font-body text-body-sm text-on-surface-muted">{idiomas}</p>
      </li>
    </ul>
  </div>
</section>
